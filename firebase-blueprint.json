{
  "entities": {
    "ChannelConfig": {
      "title": "ChannelConfig",
      "description": "Publicly readable live broadcast configuration and official social links managed exclusively by the channel owner.",
      "type": "object",
      "properties": {
        "primaryLiveUrl": { "type": "string" },
        "backupLiveUrl": { "type": "string" },
        "liveTitle": { "type": "string" },
        "youtubeHandle": { "type": "string" },
        "youtubeChannelId": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "telegramUrl": { "type": "string" },
        "tiktokUrl": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "satelliteFrequency": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "primaryLiveUrl",
        "backupLiveUrl",
        "liveTitle",
        "youtubeHandle",
        "youtubeChannelId",
        "facebookUrl",
        "telegramUrl",
        "tiktokUrl",
        "instagramUrl",
        "satelliteFrequency",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "CoverageRequest": {
      "title": "CoverageRequest",
      "description": "Viewer booking request for field coverage and live broadcast.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "senderName": { "type": "string" },
        "phone": { "type": "string" },
        "governorate": { "type": "string" },
        "serviceType": { "type": "string" },
        "eventDate": { "type": "string" },
        "topic": { "type": "string" },
        "details": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "declined"]
        },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "senderName",
        "phone",
        "governorate",
        "serviceType",
        "eventDate",
        "topic",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChannelEventItem": {
      "title": "ChannelEventItem",
      "description": "Channel event/occasion published by the channel owner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "hijriDate": { "type": "string" },
        "gregorianDate": { "type": "string" },
        "timeLabel": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["ONGOING", "UPCOMING", "ARCHIVED"] },
        "description": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "hijriDate",
        "gregorianDate",
        "timeLabel",
        "location",
        "status",
        "description",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChannelNewsItem": {
      "title": "ChannelNewsItem",
      "description": "News or field report published by the channel owner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "fullBody": { "type": "string" },
        "publishedAt": { "type": "string" },
        "readingTime": { "type": "string" },
        "author": { "type": "string" },
        "breaking": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "summary",
        "fullBody",
        "publishedAt",
        "readingTime",
        "author",
        "breaking",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChannelVideoItem": {
      "title": "ChannelVideoItem",
      "description": "Video or program item published by the channel owner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "publishedAt": { "type": "string" },
        "description": { "type": "string" },
        "videoUrl": { "type": "string" },
        "presenter": { "type": "string" },
        "youtubeVideoId": { "type": "string" },
        "youtubeWatchUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "category",
        "duration",
        "publishedAt",
        "description",
        "videoUrl",
        "presenter",
        "featured",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChannelCoverageItem": {
      "title": "ChannelCoverageItem",
      "description": "Field coverage report published by the channel owner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "reporter": { "type": "string" },
        "timestampLabel": { "type": "string" },
        "statusLabel": { "type": "string" },
        "summary": { "type": "string" },
        "videoUrl": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "liveField": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "location",
        "reporter",
        "timestampLabel",
        "statusLabel",
        "summary",
        "videoUrl",
        "liveField",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/channel_config/{configId}": {
      "schema": { "$ref": "#/entities/ChannelConfig" },
      "description": "Single public broadcast config doc ('live'), writable strictly by the verified channel owner."
    },
    "/coverage_requests/{requestId}": {
      "schema": { "$ref": "#/entities/CoverageRequest" },
      "description": "Coverage and live broadcast booking requests isolated per requester and manageable by the verified channel owner."
    },
    "/channel_events/{eventId}": {
      "schema": { "$ref": "#/entities/ChannelEventItem" },
      "description": "Channel events managed by the verified owner and readable by all viewers."
    },
    "/channel_news/{newsId}": {
      "schema": { "$ref": "#/entities/ChannelNewsItem" },
      "description": "Channel news managed by the verified owner and readable by all viewers."
    },
    "/channel_videos/{videoId}": {
      "schema": { "$ref": "#/entities/ChannelVideoItem" },
      "description": "Channel videos managed by the verified owner and readable by all viewers."
    },
    "/channel_coverages/{coverageId}": {
      "schema": { "$ref": "#/entities/ChannelCoverageItem" },
      "description": "Channel field coverages managed by the verified owner and readable by all viewers."
    }
  }
}
